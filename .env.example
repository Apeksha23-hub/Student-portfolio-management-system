# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Random string used to sign sessions and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Leave empty to use SQLite at instance/app.db.
# MySQL example (needs "pip install pymysql"):
# DATABASE_URL=mysql+pymysql://user:password@localhost/portfolio_db
DATABASE_URL=

# Google Gemini free-tier key from https://aistudio.google.com/app/apikey
# Leave empty to run without AI (the app still works fully).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for the AI before giving up
LLM_TIMEOUT=15

# Maximum AI actions per student per day
AI_DAILY_LIMIT=20
